<Window x:Class="Askart.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Askart - Мессенджер" 
        Height="700" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Icon="/Resources/logo.png">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель со списком чатов -->
        <Border Grid.Column="0" Background="{StaticResource SecondaryBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <Border Grid.Row="0" Background="{StaticResource ActiveBrush}" Padding="20">
                    <Grid>
                        <TextBlock Text="Askart" 
                                   FontFamily="{StaticResource Roboto}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                        <Button Content="+" 
                                Width="35" 
                                Height="35"
                                FontSize="20"
                                FontWeight="Bold"
                                Background="White"
                                Foreground="{StaticResource ActiveBrush}"
                                BorderThickness="0"
                                
                                HorizontalAlignment="Right"
                                Cursor="Hand"
                                Click="CreateChat_Click"/>
                    </Grid>
                </Border>

                <!-- Список чатов -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ChatListPanel">
                        <!-- Чаты будут добавляться здесь -->
                    </StackPanel>
                </ScrollViewer>

                <!-- Профиль -->
                <Border Grid.Row="2" Background="{StaticResource CardBackgroundBrush}" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="45" Height="45" Fill="{StaticResource ActiveBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="👤" 
                                   FontSize="24" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UserNameText" 
                                       FontFamily="{StaticResource Roboto}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="Онлайн" 
                                       FontFamily="{StaticResource Roboto}"
                                       FontSize="12"
                                       Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>

                        <Button Content="⚙" 
                                Width="35" 
                                Height="35"
                                FontSize="16"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Right"
                                Cursor="Hand"
                                Click="Profile_Click"
                                Grid.Column="1"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Правая панель с сообщениями -->
        <Grid Grid.Column="1" x:Name="ChatArea">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок чата -->
            <Border x:Name="ChatHeader"
                    Grid.Row="0" 
                    Background="{StaticResource CardBackgroundBrush}" 
                    Padding="20" 
                    BorderBrush="#E0E0E0" 
                    BorderThickness="0,0,0,1" 
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="ChatNameText" 
                                   FontFamily="{StaticResource Roboto}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="ChatTypeText" 
                                   FontFamily="{StaticResource Roboto}"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <Button x:Name="KanbanButton"
                            Grid.Column="1"
                            Content=" Канбан"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="15,8"
                            Click="Kanban_Click"
                            Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Сообщения -->
            <ScrollViewer x:Name="MessagesScroll" 
                          Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          Padding="20"
                          Visibility="Collapsed">
                <StackPanel x:Name="MessagesPanel"/>
            </ScrollViewer>

            <!-- Поле ввода -->
            <Border x:Name="InputArea"
                    Grid.Row="2" 
                    Background="{StaticResource CardBackgroundBrush}" 
                    Padding="20" 
                    BorderBrush="#E0E0E0" 
                    BorderThickness="0,1,0,0" 
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="MessageTextBox"
                             Style="{StaticResource InputTextBoxStyle}"
                             Height="50"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MaxHeight="100"/>

                    <Button Grid.Column="1"
                            Content="Отправить"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="25,12"
                            Margin="10,0,0,0"
                            Click="Send_Click"/>
                </Grid>
            </Border>

            <!-- Приветствие (показывается когда чат не выбран) -->
            <StackPanel x:Name="WelcomePanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Добро пожаловать в Askart!" 
                           FontFamily="{StaticResource Roboto}"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>
                <TextBlock Text="Выберите чат слева или создайте новый" 
                           FontFamily="{StaticResource Roboto}"
                           FontSize="16"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>