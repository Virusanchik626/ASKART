
<Window x:Class="Askart.Windows.PinnedMessagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Закреплённые сообщения" 
        Height="500" 
        Width="600"
        MinWidth="400"
        MinHeight="300"
        Icon="/Resources/logo.png"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ActiveBrush}" Padding="20">
            <Grid>
                <TextBlock Text="📌 Закреплённые сообщения" 
                           FontFamily="{StaticResource Roboto}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ChatNameText" 
                           FontFamily="{StaticResource Roboto}"
                           FontSize="12"
                           Foreground="White"
                           Opacity="0.9"
                           VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <Grid>
 <TextBlock Text="В этом чате пока нет закреплённых сообщений" FontFamily="{DynamicResource Roboto}"
            FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,30,0,0">
  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
   <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=PinnedPanel}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
  </Style></TextBlock.Style>
 </TextBlock>
 <ItemsControl x:Name="PinnedPanel">
  <ItemsControl.ItemTemplate><DataTemplate>
   <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="15" Margin="0,0,0,10" BorderBrush="#FFC107" BorderThickness="3">
    <Border.Effect><DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.15"/></Border.Effect>
    <StackPanel>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding SenderName, StringFormat=📌 {0}}" FontFamily="{DynamicResource Roboto}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding SendTime, StringFormat=dd.MM.yyyy HH:mm}" FontFamily="{DynamicResource Roboto}" FontSize="11" Foreground="{DynamicResource InactiveTextBrush}" VerticalAlignment="Center"/>
     </Grid>
     <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,10,0,10"/>
     <TextBlock Text="{Binding Text}" FontFamily="{DynamicResource Roboto}" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding EditTime, StringFormat=Отредактировано: {0:dd.MM.yyyy HH:mm}}" FontFamily="{DynamicResource Roboto}" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource InactiveTextBrush}" HorizontalAlignment="Right" Margin="0,5,0,0">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers>
       <DataTrigger Binding="{Binding EditTime}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    </StackPanel>
   </Border>
  </DataTemplate></ItemsControl.ItemTemplate>
 </ItemsControl>
</Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" Padding="15">
            <Button Content="Закрыть"
                    Style="{StaticResource StandardButtonStyle}"
                    HorizontalAlignment="Center"
                    Padding="30,10"
                    Click="Close_Click"/>
        </Border>
    </Grid>
</Window>


