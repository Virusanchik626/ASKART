<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Askart.Windows.AdminWindow" Title="Askart — Администратор" Width="1150" Height="720" MinWidth="900" MinHeight="560" Icon="/Resources/logo.png" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}" xmlns:views="clr-namespace:Askart.Views.Administration" xmlns:vm="clr-namespace:Askart.ViewModels.Administration">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/AdminStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SecondaryBackgroundBrush}" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="5,5,5,25">
                    <Image Source="/Resources/logo.png" Width="48" Height="48" HorizontalAlignment="Left"/>
                    <TextBlock Text="ASKART" Style="{StaticResource AdminText}" FontSize="20" FontWeight="Bold" Margin="0,10,0,0"/>
                    <TextBlock Text="Панель администратора" Style="{StaticResource AdminSecondary}"/>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource AdminNav}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Navigation.Section}" Value="{x:Static vm:AdminSection.Statistics}">
                                        <Setter Property="Background" Value="{DynamicResource ActiveBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding Navigation.Statistics}"/>
                        </Border.InputBindings>
                        <TextBlock Text="📊  Статистика">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AdminNavLabel}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Navigation.Section}" Value="{x:Static vm:AdminSection.Statistics}">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource AdminNav}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Navigation.Section}" Value="{x:Static vm:AdminSection.Users}">
                                        <Setter Property="Background" Value="{DynamicResource ActiveBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding Navigation.Users}"/>
                        </Border.InputBindings>
                        <TextBlock Text="👥  Пользователи">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AdminNavLabel}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Navigation.Section}" Value="{x:Static vm:AdminSection.Users}">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource AdminNav}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Navigation.Section}" Value="{x:Static vm:AdminSection.Chats}">
                                        <Setter Property="Background" Value="{DynamicResource ActiveBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding Navigation.Chats}"/>
                        </Border.InputBindings>
                        <TextBlock Text="💬  Чаты и сообщения">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AdminNavLabel}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Navigation.Section}" Value="{x:Static vm:AdminSection.Chats}">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="{Binding Navigation.AdminName}" Style="{StaticResource AdminSecondary}" TextWrapping="Wrap" Margin="5,0,5,10"/>
                    <Button Content="Выйти" Command="{Binding Navigation.Logout}" Padding="15,8,15,8" Margin="0" Background="Transparent" BorderThickness="1" Cursor="Hand" BorderBrush="{DynamicResource SecondaryTextBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Column="1" Padding="25">
            <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Askart.Views.Administration" xmlns:vm="clr-namespace:Askart.ViewModels.Administration" x:Name="SectionHost" Opacity="1">
                <Grid.Resources>
                    <Storyboard x:Key="SectionTransition" FillBehavior="Stop">
                        <DoubleAnimation Storyboard.TargetName="SectionHost" Storyboard.TargetProperty="Opacity" From="0.75" To="1" Duration="0:0:0.15"/>
                    </Storyboard>
                </Grid.Resources>
                <views:AdminStatisticsView DataContext="{Binding Statistics}">
                    <views:AdminStatisticsView.Style>
                        <Style TargetType="UserControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Navigation.Section}" Value="{x:Static vm:AdminSection.Statistics}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:AdminStatisticsView.Style>
                </views:AdminStatisticsView>
                <views:AdminUsersView DataContext="{Binding Users}">
                    <views:AdminUsersView.Style>
                        <Style TargetType="UserControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Navigation.Section}" Value="{x:Static vm:AdminSection.Users}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:AdminUsersView.Style>
                </views:AdminUsersView>
                <views:AdminChatsView DataContext="{Binding Chats}">
                    <views:AdminChatsView.Style>
                        <Style TargetType="UserControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Navigation.Section}" Value="{x:Static vm:AdminSection.Chats}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:AdminChatsView.Style>
                </views:AdminChatsView>
            </Grid>
        </Border>
    </Grid>
</Window>
