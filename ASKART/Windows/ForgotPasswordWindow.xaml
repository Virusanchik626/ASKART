<Window x:Class="Askart.Windows.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Восстановление пароля - Askart" 
        Height="600" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="White"
        ResizeMode="NoResize"
        Icon="/Resources/logo.png"
        MinWidth="900" MinHeight="600">

    <Grid>
        <!-- Декоративные элементы -->
        <Canvas>
            <!-- Вопросительные знаки -->
            <TextBlock Text="?" FontSize="60" Foreground="#5DD4FF" Canvas.Left="100" Canvas.Top="80" Opacity="0.6"/>
            <TextBlock Text="?" FontSize="40" Foreground="#5DD4FF" Canvas.Left="700" Canvas.Top="120" Opacity="0.6"/>
            <TextBlock Text="?" FontSize="35" Foreground="#5DD4FF" Canvas.Left="150" Canvas.Top="350" Opacity="0.6"/>
            <TextBlock Text="?" FontSize="45" Foreground="#5DD4FF" Canvas.Left="750" Canvas.Top="300" Opacity="0.6"/>
            <TextBlock Text="?" FontSize="30" Foreground="#5DD4FF" Canvas.Left="200" Canvas.Top="200" Opacity="0.6"/>
            <TextBlock Text="?" FontSize="35" Foreground="#5DD4FF" Canvas.Left="650" Canvas.Top="400" Opacity="0.6"/>

            
        </Canvas>

        <!-- Центральная карточка -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="450">
            <TextBlock Text="Забыли ваш пароль?" 
                       FontFamily="{StaticResource Roboto}"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Введите свою почту и мы пришлём вам ссылку для восстановления пароля"
                       FontFamily="{StaticResource Roboto}"
                       FontSize="14"
                       Foreground="#757575"
                       TextAlignment="Center"
                       Margin="0,0,0,30"/>

            <TextBox x:Name="EmailTextBox"
                     Style="{StaticResource InputTextBoxStyle}"
                     Margin="0,0,0,25"
                     Height="50"/>

            <Button Content="Прислать письмо"
                    Style="{StaticResource StandardButtonStyle}"
                    Click="SendEmail_Click"
                    Height="50"
                    Margin="0,0,0,40"/>

            <TextBlock Text="обратно в авторизацию"
                       Style="{StaticResource LinkTextStyle}"
                       HorizontalAlignment="Center"
                       MouseLeftButtonDown="BackToLogin_Click"/>
        </StackPanel>
    </Grid>
</Window>