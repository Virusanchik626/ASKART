<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Askart.Windows.MainWindow" Title="Askart - Мессенджер" Height="700" Width="1200" MinWidth="900" MinHeight="600" Icon="/Resources/logo.png" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource SecondaryBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource ActiveBrush}" Padding="20">
                    <Grid>
                        <TextBlock Text="Askart" FontFamily="{StaticResource Roboto}" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Content="+" Width="35" Height="35" FontSize="20" FontWeight="Bold" Background="White" Foreground="{DynamicResource ActiveBrush}" BorderThickness="0" Cursor="Hand" Click="CreateChat_Click" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" Padding="10" Margin="10,10,10,5">
                    <TextBox x:Name="SearchTextBox" Style="{StaticResource InputTextBoxStyle}" Height="40" TextChanged="Search_TextChanged"/>
                </Border>
                <Border Grid.Row="2" Padding="10,0,10,5">
                    <CheckBox x:Name="ShowArchivedCheckBox" Content="Показать архивные чаты" FontFamily="{StaticResource Roboto}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Checked="FilterChanged" Unchecked="FilterChanged"/>
                </Border>
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ChatListPanel">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Cursor="Hand" Tag="{Binding Chat}" MouseLeftButtonDown="ChatCard_MouseDown">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ChatCardStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ActiveBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="45" Height="45" CornerRadius="22.5" Background="#6496C8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Initial}" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource Roboto}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding TypeName}" FontFamily="{DynamicResource Roboto}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="45" Height="45" Fill="{DynamicResource ActiveBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UserNameText" FontFamily="{StaticResource Roboto}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                        <Button Content="⚙" Width="35" Height="35" FontSize="16" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand" Click="Profile_Click" Grid.Column="1"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <!-- Правая панель -->
        <Grid Grid.Column="1" x:Name="ChatArea">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Заголовок чата -->
            <Border x:Name="ChatHeader" Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" Padding="20" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ChatNameText" FontFamily="{StaticResource Roboto}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="ChatTypeText" FontFamily="{StaticResource Roboto}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <Button x:Name="MembersButton" Grid.Column="1" Content="👥 Участники" Style="{StaticResource StandardButtonStyle}" Padding="12,8" Margin="5,0,0,0" Click="Members_Click"/>
                    <Button x:Name="PinnedButton" Grid.Column="2" Content="📌 Закреплённые" Style="{StaticResource StandardButtonStyle}" Padding="12,8" Margin="5,0,0,0" Click="Pinned_Click" Visibility="Collapsed"/>
                    <Button x:Name="StatsButton" Grid.Column="3" Content="📊 Статистика" Style="{StaticResource StandardButtonStyle}" Padding="12,8" Margin="5,0,0,0" Click="Stats_Click" Visibility="Collapsed"/>
                    <Button x:Name="ArchiveButton" Grid.Column="4" Content="📦 Архивировать" Style="{StaticResource StandardButtonStyle}" Padding="12,8" Margin="5,0,0,0" Click="Archive_Click" Visibility="Collapsed"/>
                    <Button x:Name="KanbanButton" Grid.Column="5" Content=" Канбан" Style="{StaticResource StandardButtonStyle}" Padding="12,8" Margin="5,0,0,0" Click="Kanban_Click" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <!-- Панель закреплённых сообщений -->
            <Border x:Name="PinnedBar" Grid.Row="1" Background="{DynamicResource PinnedBarBackgroundBrush}" Padding="15,10,15,10" BorderBrush="#FFC107" BorderThickness="0,0,0,1" Cursor="Hand" MouseLeftButtonDown="PinnedBar_Click" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="📌" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="PinnedBarText" Grid.Column="1" FontFamily="{StaticResource Roboto}" FontSize="12" Foreground="{DynamicResource PinnedBarTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="Открыть все →" FontFamily="{StaticResource Roboto}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PinnedBarTextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
            </Border>
            <!-- Сообщения -->
            <ScrollViewer x:Name="MessagesScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{Binding Status}" FontFamily="{DynamicResource Roboto}" FontSize="14" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl x:Name="MessagesPanel" ItemsSource="{Binding Messages}">
                        <ItemsControl.Resources>
                            <BooleanToVisibilityConverter x:Key="MessageVisibility"/>
                        </ItemsControl.Resources>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,5,0,5" Padding="15,10,15,10" CornerRadius="12" MaxWidth="500">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Background" Value="{DynamicResource ActiveBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Message.IsPinned}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#FFC107"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Копировать" Command="{Binding Conversation.Copy}" CommandParameter="{Binding Message}"/>
                                            <MenuItem Header="↩ Ответить" Command="{Binding Conversation.Reply}" CommandParameter="{Binding Message}"/>
                                            <MenuItem Header="✏️ Редактировать" Command="{Binding Conversation.Edit}" CommandParameter="{Binding Message}" Visibility="{Binding IsOwn, Converter={StaticResource MessageVisibility}}"/>
                                            <MenuItem Header="✕ Удалить" Command="{Binding Conversation.Delete}" CommandParameter="{Binding Message}" Visibility="{Binding CanDelete, Converter={StaticResource MessageVisibility}}"/>
                                            <MenuItem Header="{Binding PinHeader}" Command="{Binding Conversation.TogglePin}" CommandParameter="{Binding Message}" Visibility="{Binding IsAdmin, Converter={StaticResource MessageVisibility}}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Sender}" FontFamily="{DynamicResource Roboto}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding CanDelete, Converter={StaticResource MessageVisibility}}">
                                                <Button Content="✏️" ToolTip="Редактировать" Command="{Binding Conversation.Edit}" CommandParameter="{Binding Message}" Visibility="{Binding IsOwn, Converter={StaticResource MessageVisibility}}" Background="Transparent" BorderThickness="0" FontSize="12" Cursor="Hand" Padding="4,0,4,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="✕" ToolTip="{Binding DeleteTip}" Command="{Binding Conversation.Delete}" CommandParameter="{Binding Message}" Visibility="{Binding CanDelete, Converter={StaticResource MessageVisibility}}" Background="Transparent" BorderThickness="0" FontSize="12" Cursor="Hand" Padding="4,0,4,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="{Binding PinIcon}" ToolTip="{Binding PinTip}" Command="{Binding Conversation.TogglePin}" CommandParameter="{Binding Message}" Visibility="{Binding IsAdmin, Converter={StaticResource MessageVisibility}}" Background="Transparent" BorderThickness="0" FontSize="12" Cursor="Hand" Padding="4,0,4,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="↩" ToolTip="Ответить" Command="{Binding Conversation.Reply}" CommandParameter="{Binding Message}" Visibility="{Binding CanDelete, Converter={StaticResource MessageVisibility}}" Background="Transparent" BorderThickness="0" FontSize="12" Cursor="Hand" Padding="4,0,4,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <Border Background="#28FFFFFF" CornerRadius="6" Padding="8,6,8,6" Margin="0,5,0,5" BorderBrush="#64C8FF" BorderThickness="2,0,0,0" Visibility="{Binding HasReply, Converter={StaticResource MessageVisibility}}">
                                            <TextBlock Text="{Binding ReplyText}" FontFamily="{DynamicResource Roboto}" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" MaxHeight="40">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                                <Setter Property="Foreground" Value="#C8F0FF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="{Binding Message.Text}" FontFamily="{DynamicResource Roboto}" FontSize="14" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Time}" FontFamily="{DynamicResource Roboto}" FontSize="11" HorizontalAlignment="Right" Margin="0,5,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource InactiveTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                            <Setter Property="Foreground" Value="#C8F0FF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <!-- Панель ответа -->
            <Border x:Name="ReplyPanel" Grid.Row="3" Background="{DynamicResource SecondaryBackgroundBrush}" Padding="15,10,15,10" BorderBrush="{DynamicResource ActiveBrush}" BorderThickness="0,1,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="↩" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource ActiveBrush}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ReplyAuthorText" FontFamily="{StaticResource Roboto}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ActiveBrush}"/>
                        <TextBlock x:Name="ReplyPreviewText" FontFamily="{StaticResource Roboto}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="✕" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" Cursor="Hand" Click="CancelReply_Click" Padding="5"/>
                </Grid>
            </Border>
            <!-- Поле ввода -->
            <Border x:Name="InputArea" Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}" Padding="20" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MessageTextBox" Style="{StaticResource InputTextBoxStyle}" Height="50" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="100" KeyDown="MessageTextBox_KeyDown"/>
                    <Button Grid.Column="1" Content="😊" FontSize="20" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0" Click="Emoji_Click"/>
                    <Button Grid.Column="2" Content="Отправить" Padding="25,12" Margin="10,0,0,0" Click="Send_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSending}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
            <!-- Приветствие -->
            <StackPanel x:Name="WelcomePanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Добро пожаловать в Askart!" FontFamily="{StaticResource Roboto}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <TextBlock Text="Выберите чат слева или создайте новый" FontFamily="{StaticResource Roboto}" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
