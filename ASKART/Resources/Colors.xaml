<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="LightBackgroundColor">#FFFFFF</Color>
    <Color x:Key="LightSecondaryBackgroundColor">#F5F5F5</Color>
    <Color x:Key="LightPrimaryTextColor">#000000</Color>
    <Color x:Key="LightSecondaryTextColor">#757575</Color>
    <Color x:Key="LightInactiveTextColor">#9E9E9E</Color>
    <Color x:Key="LightActiveColor">#5DD4FF</Color>
    <Color x:Key="LightSuccessColor">#4CAF50</Color>
    <Color x:Key="LightErrorColor">#F44336</Color>
    <Color x:Key="LightCardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="LightInputBackgroundColor">#FFFFFF</Color>
    <Color x:Key="LightLineColor">#E0E0E0</Color>
    <Color x:Key="LightPinnedBarBackgroundColor">#FFF9E6</Color>
    <Color x:Key="LightPinnedBarTextColor">#856404</Color>

    <Color x:Key="DarkBackgroundColor">#202020</Color>
    <Color x:Key="DarkSecondaryBackgroundColor">#2A2A2A</Color>
    <Color x:Key="DarkPrimaryTextColor">#FFFFFF</Color>
    <Color x:Key="DarkSecondaryTextColor">#B0B0B0</Color>
    <Color x:Key="DarkInactiveTextColor">#8A8A8A</Color>
    <Color x:Key="DarkActiveColor">#5DD4FF</Color>
    <Color x:Key="DarkSuccessColor">#4CAF50</Color>
    <Color x:Key="DarkErrorColor">#EF5350</Color>
    <Color x:Key="DarkCardBackgroundColor">#2F2F2F</Color>
    <Color x:Key="DarkInputBackgroundColor">#3A3A3A</Color>
    <Color x:Key="DarkLineColor">#454545</Color>
    <Color x:Key="DarkPinnedBarBackgroundColor">#3D3520</Color>
    <Color x:Key="DarkPinnedBarTextColor">#FFD966</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource LightBackgroundColor}"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource LightSecondaryBackgroundColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource LightPrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource LightSecondaryTextColor}"/>
    <SolidColorBrush x:Key="InactiveTextBrush" Color="{StaticResource LightInactiveTextColor}"/>
    <SolidColorBrush x:Key="ActiveBrush" Color="{StaticResource LightActiveColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource LightSuccessColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource LightErrorColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource LightCardBackgroundColor}"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource LightInputBackgroundColor}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LightLineColor}"/>
    <SolidColorBrush x:Key="PinnedBarBackgroundBrush" Color="{StaticResource LightPinnedBarBackgroundColor}"/>
    <SolidColorBrush x:Key="PinnedBarTextBrush" Color="{StaticResource LightPinnedBarTextColor}"/>

</ResourceDictionary>
