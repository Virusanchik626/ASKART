<Window x:Class="Askart.Windows.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация - Askart" 
        Height="800" 
        Width="1000"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource RegistrationBackgroundImageBrush}"
        ResizeMode="CanResize"
        Icon="/Resources/logo.png">

    <Grid>

        <!-- Карточка регистрации -->
        <Border Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="20" 
                Padding="40" 
                Width="400" 
                Height="600"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel>
                <!-- Заголовок -->
                <TextBlock Text="Регистрация" 
                           Style="{StaticResource TitleTextStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <!-- Имя -->
                <TextBlock Text="ваше имя" 
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="FirstNameTextBox" 
                         Style="{StaticResource InputTextBoxStyle}"
                         Margin="0,0,0,15"/>

                <!-- Фамилия -->
                <TextBlock Text="ваша фамилия" 
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="LastNameTextBox" 
                         Style="{StaticResource InputTextBoxStyle}"
                         Margin="0,0,0,15"/>

                <!-- Почта -->
                <TextBlock Text="почта" 
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="EmailTextBox" 
                         Style="{StaticResource InputTextBoxStyle}"
                         Margin="0,0,0,15"/>

                <!-- Пароль -->
                <TextBlock Text="пароль" 
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox" 
                             Style="{StaticResource PasswordBoxStyle}"
                             Margin="0,0,0,20"/>

                <!-- Телефон -->
                <TextBlock Text="телефон (необязательно)" 
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="PhoneTextBox" 
                           Style="{StaticResource InputTextBoxStyle}"
                           Margin="0,0,0,20"
                           ToolTip="Формат: +79991234567"/>

                <!-- Кнопка зарегистрироваться -->
                <Button Content="Зарегистрироваться" 
                        Style="{StaticResource StandardButtonStyle}"
                        Click="Register_Click"
                        Margin="0,0,0,15"/>

                <!-- Вход -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Уже есть аккаунт? " 
                               Style="{StaticResource SecondaryTextStyle}"/>
                    <TextBlock Text="Авторизоваться"
                               Style="{StaticResource LinkTextStyle}"
                               MouseLeftButtonDown="Login_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>