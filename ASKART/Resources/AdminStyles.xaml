<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    <Style x:Key="AdminText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Roboto}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>
    <Style x:Key="AdminSecondary" TargetType="TextBlock" BasedOn="{StaticResource AdminText}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
    </Style>
    <Style x:Key="AdminInactive" TargetType="TextBlock" BasedOn="{StaticResource AdminSecondary}">
        <Setter Property="Foreground" Value="{DynamicResource InactiveTextBrush}"/>
    </Style>
    <Style x:Key="AdminHeading" TargetType="TextBlock" BasedOn="{StaticResource AdminText}">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="AdminSection" TargetType="TextBlock" BasedOn="{StaticResource AdminText}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,10,0,10"/>
    </Style>
    <Style x:Key="AdminCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="15"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AdminStatus" TargetType="TextBlock" BasedOn="{StaticResource AdminSecondary}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,20,0,0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsError}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
            </DataTrigger>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="AdminMainButton" TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
        <Setter Property="Padding" Value="15,8,15,8"/>
    </Style>
    <Style x:Key="AdminDanger" TargetType="Button">
        <Setter Property="Padding" Value="15,8,15,8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
    </Style>
    <Style x:Key="AdminNav" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,10,12,10"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style x:Key="AdminNavLabel" TargetType="TextBlock" BasedOn="{StaticResource AdminText}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <DataTemplate x:Key="AdminInfoRow">
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource AdminSecondary}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource AdminText}" FontWeight="SemiBold" Margin="15,0,0,0" VerticalAlignment="Center"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
