<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Светлая тема -->
    <Color x:Key="LightBackgroundColor">#FFFFFF</Color>
    <Color x:Key="LightSecondaryBackgroundColor">#F5F5F5</Color>
    <Color x:Key="LightPrimaryTextColor">#000000</Color>
    <Color x:Key="LightSecondaryTextColor">#757575</Color>
    <Color x:Key="LightInactiveTextColor">#9E9E9E</Color>
    <Color x:Key="LightActiveColor">#5DD4FF</Color>
    <Color x:Key="LightSuccessColor">#4CAF50</Color>
    <Color x:Key="LightErrorColor">#F44336</Color>
    <Color x:Key="LightCardBackground">#FFFFFF</Color>

    <!-- Тёмная тема -->
    <Color x:Key="DarkBackgroundColor">#1A1A2E</Color>
    <Color x:Key="DarkSecondaryBackgroundColor">#16213E</Color>
    <Color x:Key="DarkPrimaryTextColor">#FFFFFF</Color>
    <Color x:Key="DarkSecondaryTextColor">#B0B0B0</Color>
    <Color x:Key="DarkInactiveTextColor">#757575</Color>
    <Color x:Key="DarkActiveColor">#5DD4FF</Color>
    <Color x:Key="DarkSuccessColor">#81C784</Color>
    <Color x:Key="DarkErrorColor">#E57373</Color>
    <Color x:Key="DarkCardBackground">#0F3460</Color>

    <!-- Кисти светлой темы -->
    <SolidColorBrush x:Key="LightBackgroundBrush" Color="{StaticResource LightBackgroundColor}"/>
    <SolidColorBrush x:Key="LightSecondaryBackgroundBrush" Color="{StaticResource LightSecondaryBackgroundColor}"/>
    <SolidColorBrush x:Key="LightPrimaryTextBrush" Color="{StaticResource LightPrimaryTextColor}"/>
    <SolidColorBrush x:Key="LightSecondaryTextBrush" Color="{StaticResource LightSecondaryTextColor}"/>
    <SolidColorBrush x:Key="LightInactiveTextBrush" Color="{StaticResource LightInactiveTextColor}"/>
    <SolidColorBrush x:Key="LightActiveBrush" Color="{StaticResource LightActiveColor}"/>
    <SolidColorBrush x:Key="LightSuccessBrush" Color="{StaticResource LightSuccessColor}"/>
    <SolidColorBrush x:Key="LightErrorBrush" Color="{StaticResource LightErrorColor}"/>
    <SolidColorBrush x:Key="LightCardBackgroundBrush" Color="{StaticResource LightCardBackground}"/>

    <!-- Кисти тёмной темы -->
    <SolidColorBrush x:Key="DarkBackgroundBrush" Color="{StaticResource DarkBackgroundColor}"/>
    <SolidColorBrush x:Key="DarkSecondaryBackgroundBrush" Color="{StaticResource DarkSecondaryBackgroundColor}"/>
    <SolidColorBrush x:Key="DarkPrimaryTextBrush" Color="{StaticResource DarkPrimaryTextColor}"/>
    <SolidColorBrush x:Key="DarkSecondaryTextBrush" Color="{StaticResource DarkSecondaryTextColor}"/>
    <SolidColorBrush x:Key="DarkInactiveTextBrush" Color="{StaticResource DarkInactiveTextColor}"/>
    <SolidColorBrush x:Key="DarkActiveBrush" Color="{StaticResource DarkActiveColor}"/>
    <SolidColorBrush x:Key="DarkSuccessBrush" Color="{StaticResource DarkSuccessColor}"/>
    <SolidColorBrush x:Key="DarkErrorBrush" Color="{StaticResource DarkErrorColor}"/>
    <SolidColorBrush x:Key="DarkCardBackgroundBrush" Color="{StaticResource DarkCardBackground}"/>

    <!-- Текущая тема (по умолчанию светлая) -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource LightBackgroundColor}"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource LightSecondaryBackgroundColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource LightPrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource LightSecondaryTextColor}"/>
    <SolidColorBrush x:Key="InactiveTextBrush" Color="{StaticResource LightInactiveTextColor}"/>
    <SolidColorBrush x:Key="ActiveBrush" Color="{StaticResource LightActiveColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource LightSuccessColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource LightErrorColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource LightCardBackground}"/>

</ResourceDictionary>