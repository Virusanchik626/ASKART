<Window x:Class="Askart.Windows.ChatStatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статистика чата" 
        Height="600" 
        Width="600"
        MinWidth="450"
        MinHeight="400"
        Icon="/Resources/logo.png"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="{StaticResource ActiveBrush}" Padding="20">
            <Grid>
                <TextBlock Text="📊 Статистика чата" 
                           FontFamily="{StaticResource Roboto}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ChatNameText" 
                           FontFamily="{StaticResource Roboto}"
                           FontSize="12"
                           Foreground="White"
                           Opacity="0.9"
                           VerticalAlignment="Bottom" Margin="0,35,0,0"/>
            </Grid>
        </Border>

        <!-- Контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel x:Name="StatsPanel"/>
        </ScrollViewer>

        <!-- Кнопка закрытия -->
        <Border Grid.Row="2" Background="{StaticResource CardBackgroundBrush}" Padding="15">
            <Button Content="Закрыть"
                    Style="{StaticResource StandardButtonStyle}"
                    HorizontalAlignment="Center"
                    Padding="30,10"
                    Click="Close_Click"/>
        </Border>
    </Grid>
</Window>