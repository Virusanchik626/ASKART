
<Window x:Class="Askart.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация - Askart" 
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource LoginBackgroundImageBrush}"
        ResizeMode="NoResize"
        Icon="/Resources/logo.png"
        MinWidth="900" MinHeight="600">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Rectangle Grid.Row="0" Fill="{DynamicResource ActiveBrush}" Opacity="0.1"/>

        

        <Border Grid.Row="0" 
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="20" 
                Padding="40" 
                Width="400" 
                Height="500"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel>
                <TextBlock Text="Авторизация" 
                           Style="{StaticResource TitleTextStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <TextBlock Text="почта" 
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="EmailTextBox" 
                         Style="{StaticResource InputTextBoxStyle}"
                         Margin="0,0,0,20"
                         Text="test@test.com"/>

                <TextBlock Text="пароль" 
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox" 
                             Style="{StaticResource PasswordBoxStyle}"
                             Margin="0,0,0,15"
                             Password="12345678"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="RememberMeCheckBox" 
                              Content="запомнить меня"
                              FontFamily="{StaticResource Roboto}"
                              FontSize="12"
                              VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1" 
                               Text="забыл пароль"
                               Style="{StaticResource LinkTextStyle}"
                               MouseLeftButtonDown="ForgotPassword_Click"
                               VerticalAlignment="Center"/>
                </Grid>

                <Button Content="Войти" 
                        Style="{StaticResource StandardButtonStyle}"
                        Click="Login_Click"
                        Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Ещё нет аккаунта? " 
                               Style="{StaticResource SecondaryTextStyle}"/>
                    <TextBlock Text="Зарегистрироваться"
                               Style="{StaticResource LinkTextStyle}"
                               MouseLeftButtonDown="Register_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>


