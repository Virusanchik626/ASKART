<Window x:Class="Askart.Windows.CreateTaskDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Resources/logo.png" WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}" Title="Новая задача" Width="450" Height="450" MinWidth="400" MinHeight="400">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
 <TextBlock Text="Название задачи" FontFamily="{DynamicResource Roboto}" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,5"/>
 <TextBox x:Name="nameTextBox" MaxLength="50" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,15"/>
 <TextBlock Text="Описание" FontFamily="{DynamicResource Roboto}" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,5"/>
 <TextBox x:Name="descTextBox" Style="{StaticResource InputTextBoxStyle}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15"/>
 <TextBlock Text="Колонка" FontFamily="{DynamicResource Roboto}" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,5"/>
 <ComboBox x:Name="columnComboBox" Style="{StaticResource ComboBoxStyle}" Margin="0,0,0,15"/>
 <TextBlock Text="Приоритет" FontFamily="{DynamicResource Roboto}" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,5"/>
 <ComboBox x:Name="priorityComboBox" Style="{StaticResource ComboBoxStyle}" Margin="0,0,0,15"/>
 <TextBlock Text="Срок выполнения" FontFamily="{DynamicResource Roboto}" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,5"/>
 <DatePicker x:Name="deadlinePicker" FontFamily="{DynamicResource Roboto}" Padding="15,12,15,12" Margin="0,0,0,20"/>
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
 <Button Content="Отмена" Padding="15,8,15,8" Margin="0,0,10,0" Background="Transparent" BorderThickness="1" Cursor="Hand" BorderBrush="{DynamicResource SecondaryTextBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Click="Cancel_Click"/>
 <Button Content="Создать" Style="{StaticResource StandardButtonStyle}" Padding="15,8,15,8" Click="CreateButton_Click"/>
 </StackPanel>
 </StackPanel></ScrollViewer>
</Window>