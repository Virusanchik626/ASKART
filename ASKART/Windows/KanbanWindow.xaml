
<Window x:Class="Askart.Windows.KanbanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Канбан-доска - Askart" 
        Height="700" 
        Width="1200"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Icon="/Resources/logo.png">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ActiveBrush}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="← Назад"
                        Background="White"
                        Foreground="{DynamicResource ActiveBrush}"
                        Padding="15,8"
                        BorderThickness="0"
                        FontFamily="{StaticResource Roboto}"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="Back_Click"
                        Margin="0,0,10,0"/>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Канбан-доска" 
                               FontFamily="{StaticResource Roboto}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock x:Name="ChatNameText" 
                               FontFamily="{StaticResource Roboto}"
                               FontSize="14"
                               Foreground="White"
                               Opacity="0.9"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="+ Новая задача"
                        Style="{StaticResource StandardButtonStyle}"
                        Background="White"
                        Foreground="{DynamicResource ActiveBrush}"
                        Padding="15,8"
                        Margin="0,0,10,0"
                        Click="AddTask_Click"/>

                <Button Grid.Column="3"
                        Content="+ Колонка"
                        Style="{StaticResource StandardButtonStyle}"
                        Background="White"
                        Foreground="{DynamicResource ActiveBrush}"
                        Padding="15,8"
                        Click="AddColumn_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="20">
            <ItemsControl x:Name="ColumnsPanel">
 <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
 <ItemsControl.Resources>
  <Style x:Key="ColumnAction" TargetType="Button">
   <Setter Property="Background" Value="#64FFFFFF"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="16"/>
   <Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/>
   <Setter Property="Margin" Value="0,0,5,0"/><Setter Property="Tag" Value="{Binding Column}"/>
  </Style>
 </ItemsControl.Resources>
 <ItemsControl.ItemTemplate><DataTemplate>
  <Border Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="12" Width="300" Margin="0,0,10,0" VerticalAlignment="Stretch">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Padding="15" Background="{Binding Column.Color}" CornerRadius="12,12,0,0">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Column.Name}" FontFamily="{DynamicResource Roboto}" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Content="+" Style="{StaticResource ColumnAction}" Click="QuickAddTask_Click"/>
      <Button Grid.Column="2" Content="⚙" FontSize="14" Style="{StaticResource ColumnAction}" Click="ColumnSettings_Click"/>
      <Button Grid.Column="3" Content="←" Style="{StaticResource ColumnAction}" Click="MoveColumnLeft_Click"/>
      <Button Grid.Column="4" Content="→" Style="{StaticResource ColumnAction}" Margin="0" Click="MoveColumnRight_Click"/>
     </Grid>
    </Border>
    <Border Grid.Row="1" Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" Padding="15,10,15,10" BorderThickness="0,0,0,1">
     <Button Content="✕ Удалить колонку" Background="Transparent" Foreground="{DynamicResource ErrorBrush}" BorderThickness="0" FontSize="12" Cursor="Hand" Tag="{Binding Column}" HorizontalAlignment="Right" Click="DeleteColumn_Click"/>
    </Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" AllowDrop="True" Tag="{Binding Column}" Drop="TaskDrop" DragOver="TaskDragOver">
     <ItemsControl ItemsSource="{Binding Tasks}" Margin="10">
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10" Cursor="Hand" Tag="{Binding}" MouseLeftButtonDown="TaskCard_MouseDown">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.1"/></Border.Effect>
        <StackPanel>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource Roboto}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="✕" FontSize="16" ToolTip="Удалить задачу" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="{DynamicResource ErrorBrush}" Padding="5,0,5,0" Tag="{Binding}" Click="DeleteTask_Click"/>
         </Grid>
         <TextBlock Text="{Binding Description}" FontFamily="{DynamicResource Roboto}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,0,8">
          <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
           <DataTrigger Binding="{Binding Description}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
           <DataTrigger Binding="{Binding Description}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
          </Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
         <TextBlock Text="{Binding Priority, StringFormat=Приоритет: {0}}" FontFamily="{DynamicResource Roboto}" FontSize="11" Margin="0,0,0,3">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding Priority}" Value="Высокий"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Priority}" Value="Средний"><Setter Property="Foreground" Value="Orange"/></DataTrigger>
           </Style.Triggers>
          </Style></TextBlock.Style>
         </TextBlock>
         <TextBlock Text="{Binding AssigneeName, StringFormat=Исполнитель: {0}}" FontFamily="{DynamicResource Roboto}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
         <TextBlock Text="{Binding Deadline, StringFormat=Срок: {0:dd.MM.yyyy}}" FontFamily="{DynamicResource Roboto}" FontSize="11" Foreground="{DynamicResource InactiveTextBrush}" Margin="0,0,0,10"/>
        </StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </Grid>
  </Border>
 </DataTemplate></ItemsControl.ItemTemplate>
</ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>


