<Window x:Class="Askart.Windows.ColumnSettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Настройки колонки" Icon="/Resources/logo.png" Width="400" Height="350" MinWidth="350" MinHeight="300"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
 <StackPanel Margin="20">
  <TextBlock Text="Название колонки" FontFamily="{DynamicResource Roboto}" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,5"/>
  <TextBox x:Name="nameTextBox" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,20"/>
  <TextBlock Text="Цвет колонки" FontFamily="{DynamicResource Roboto}" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,5"/>
  <ComboBox x:Name="colorComboBox" Style="{StaticResource ComboBoxStyle}" Margin="0,0,0,20" SelectionChanged="ColorComboBox_SelectionChanged">
   <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal">
    <Ellipse Width="16" Height="16" Fill="{Binding Code}" Margin="0,0,10,0" VerticalAlignment="Center"/>
    <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource Roboto}" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
   </StackPanel></DataTemplate></ComboBox.ItemTemplate>
  </ComboBox>
  <Border x:Name="previewBorder" Height="40" CornerRadius="8" Margin="0,0,0,20"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Отмена" Padding="15,8,15,8" Margin="0,0,10,0" Background="Transparent" BorderThickness="1" Cursor="Hand" BorderBrush="{DynamicResource SecondaryTextBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Click="Cancel_Click"/>
   <Button Content="Сохранить" Style="{StaticResource StandardButtonStyle}" Padding="15,8,15,8" Click="Save_Click"/>
  </StackPanel>
 </StackPanel>
</Window>