<Window x:Class="Askart.Windows.KanbanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Канбан-доска - Askart" 
        Height="700" 
        Width="1200"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Icon="/Resources/logo.png">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="{StaticResource ActiveBrush}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="← Назад"
                        Background="White"
                        Foreground="{StaticResource ActiveBrush}"
                        Padding="15,8"
                        BorderThickness="0"
                        FontFamily="{StaticResource Roboto}"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="Back_Click"
                        Margin="0,0,10,0"/>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Канбан-доска" 
                               FontFamily="{StaticResource Roboto}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock x:Name="ChatNameText" 
                               FontFamily="{StaticResource Roboto}"
                               FontSize="14"
                               Foreground="White"
                               Opacity="0.9"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="+ Новая задача"
                        Style="{StaticResource StandardButtonStyle}"
                        Background="White"
                        Foreground="{StaticResource ActiveBrush}"
                        Padding="15,8"
                        Margin="0,0,10,0"
                        Click="AddTask_Click"/>

                <Button Grid.Column="3"
                        Content="+ Колонка"
                        Style="{StaticResource StandardButtonStyle}"
                        Background="White"
                        Foreground="{StaticResource ActiveBrush}"
                        Padding="15,8"
                        Click="AddColumn_Click"/>
            </Grid>
        </Border>

        <!-- Горизонтальный скролл для колонок -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="20">
            <StackPanel x:Name="ColumnsPanel" Orientation="Horizontal" Margin="0,0,0,0"/>
        </ScrollViewer>
    </Grid>
</Window>