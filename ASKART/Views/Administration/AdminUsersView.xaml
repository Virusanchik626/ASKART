<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Askart.Views.Administration.AdminUsersView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/AdminStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Пользователи" Style="{StaticResource AdminHeading}"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Count}" Style="{StaticResource AdminSecondary}"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" ToolTip="ФИО, логин, почта или телефон">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding Find}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Content="Найти" Command="{Binding Find}" Style="{StaticResource AdminMainButton}" Margin="10,0,0,0"/>
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource AdminStatus}"/>
                <ItemsControl ItemsSource="{Binding Users}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AdminCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="50" Height="50" CornerRadius="25" Background="#6496C8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Initial}" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,15,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding User.FullName}" Style="{StaticResource AdminText}" FontSize="14" FontWeight="SemiBold"/>
                                            <Border Background="{DynamicResource ActiveBrush}" CornerRadius="15" Padding="10,3,10,3" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="{Binding User.IsAdmin, Converter={StaticResource BoolVisibility}}">
                                                <TextBlock Text="Админ" FontFamily="{DynamicResource Roboto}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Contacts}" Style="{StaticResource AdminSecondary}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding User.RegistrationDate, StringFormat='Регистрация: {0:dd.MM.yyyy HH:mm}'}" Style="{StaticResource AdminInactive}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding User.ChatsCount, StringFormat='Чатов: {0}'}" Style="{StaticResource AdminSecondary}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding User.MessagesCount, StringFormat='Сообщений: {0}'}" Style="{StaticResource AdminSecondary}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding User.TasksCreatedCount, StringFormat='Задач создано: {0}'}" Style="{StaticResource AdminSecondary}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
