<Window x:Class="Askart.Windows.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация - Askart" 
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize"
        Icon="/Resources/logo.png">

    <Grid>
        <!-- Фон с облаками -->
        <Rectangle Fill="#87CEEB" Opacity="0.3"/>


        <!-- Карточка регистрации -->
        <Border Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="20" 
                Padding="40" 
                Width="400" 
                Height="550"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel>
                <!-- Заголовок -->
                <TextBlock Text="Регистрация" 
                           Style="{StaticResource TitleTextStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <!-- Имя -->
                <TextBlock Text="ваше имя" 
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="FirstNameTextBox" 
                         Style="{StaticResource InputTextBoxStyle}"
                         Margin="0,0,0,15"/>

                <!-- Фамилия -->
                <TextBlock Text="ваша фамилия" 
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="LastNameTextBox" 
                         Style="{StaticResource InputTextBoxStyle}"
                         Margin="0,0,0,15"/>

                <!-- Почта -->
                <TextBlock Text="почта" 
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="EmailTextBox" 
                         Style="{StaticResource InputTextBoxStyle}"
                         Margin="0,0,0,15"/>

                <!-- Пароль -->
                <TextBlock Text="пароль" 
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox" 
                             Style="{StaticResource PasswordBoxStyle}"
                             Margin="0,0,0,20"/>

                <!-- Кнопка зарегистрироваться -->
                <Button Content="Зарегистрироваться" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Register_Click"
                        Margin="0,0,0,15"/>

                <!-- Вход -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Уже есть аккаунт? " 
                               Style="{StaticResource SecondaryTextStyle}"/>
                    <TextBlock Text="Авторизоваться"
                               Style="{StaticResource LinkTextStyle}"
                               MouseLeftButtonDown="Login_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>