
<Window x:Class="Askart.Windows.MembersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Участники чата" 
        Height="500" 
        Width="500"
        MinWidth="400"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="CanResize"
        Icon="/Resources/logo.png">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ActiveBrush}" Padding="20">
            <Grid>
                <TextBlock Text="Участники чата" 
                           FontFamily="{StaticResource Roboto}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ChatNameText" 
                           FontFamily="{StaticResource Roboto}"
                           FontSize="12"
                           Foreground="White"
                           Opacity="0.9"
                           VerticalAlignment="Bottom" Margin="0,35,0,0"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <ItemsControl x:Name="MembersPanel">
 <ItemsControl.ItemTemplate><DataTemplate>
  <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="15" Margin="0,0,0,10">
   <Border.Effect><DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.1"/></Border.Effect>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Width="50" Height="50" CornerRadius="25" Background="#6496C8" VerticalAlignment="Center">
     <TextBlock Text="{Binding Initial}" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
     <TextBlock Text="{Binding User.FullName}" FontFamily="{DynamicResource Roboto}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
     <TextBlock Text="{Binding User.Email}" FontFamily="{DynamicResource Roboto}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
    </StackPanel>
    <Border Grid.Column="2" CornerRadius="15" Padding="12,6,12,6" VerticalAlignment="Center">
     <Border.Style><Style TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding Role}" Value="Владелец"><Setter Property="Background" Value="{DynamicResource ActiveBrush}"/></DataTrigger>
       <DataTrigger Binding="{Binding Role}" Value="Администратор"><Setter Property="Background" Value="{DynamicResource ActiveBrush}"/></DataTrigger>
      </Style.Triggers>
     </Style></Border.Style>
     <TextBlock Text="{Binding Role}" FontFamily="{DynamicResource Roboto}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
    </Border>
   </Grid>
  </Border>
 </DataTemplate></ItemsControl.ItemTemplate>
</ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" Padding="15">
            <Button Content="Закрыть"
                    Style="{StaticResource StandardButtonStyle}"
                    HorizontalAlignment="Center"
                    Padding="30,10"
                    Click="Close_Click"/>
        </Border>
    </Grid>
</Window>


